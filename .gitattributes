# Auto-detect text files and normalize line endings to LF
* text=auto

*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
