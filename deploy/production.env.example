# TEMPLATE ONLY. Install a private copy at /etc/teachermitra/teachermitra.env.
# systemd EnvironmentFile syntax: literal KEY=value, no export or shell expansion.
# Fill every empty required value; never commit the resulting file.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_READ_DOT_ENV=False
DEBUG=False
SECRET_KEY=
DATABASE_URL=
# PostgreSQL URL shape: postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/DBNAME
ALLOWED_HOSTS=teachermitra.com,www.teachermitra.com
CSRF_TRUSTED_ORIGINS=https://teachermitra.com,https://www.teachermitra.com
# Native Android apps do not need CORS. Add only approved HTTPS browser origins.
CORS_ALLOWED_ORIGINS=
TIME_ZONE=Asia/Kolkata
STATIC_ROOT=/var/lib/teachermitra/static
MEDIA_ROOT=/var/lib/teachermitra/media
PRIVATE_DOCUMENT_ROOT=/var/lib/teachermitra/private_documents
CACHE_ROOT=/var/lib/teachermitra/cache
# Increase after HTTPS has been verified. No includeSubDomains or preload.
SECURE_HSTS_SECONDS=3600
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@teachermitra.com
SERVER_EMAIL=errors@teachermitra.com
