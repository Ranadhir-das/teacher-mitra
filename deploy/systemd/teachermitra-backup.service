[Unit]
Description=TeacherMitra consistent database and upload backup (brief downtime)
After=postgresql.service

[Service]
Type=oneshot
User=root
Environment=TEACHERMITRA_ALLOW_BACKUP_DOWNTIME=1
ExecStart=/usr/bin/bash /srv/teachermitra/current/deploy/scripts/backup.sh
UMask=0077
StandardOutput=journal
StandardError=journal
